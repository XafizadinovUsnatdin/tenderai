# Copy to `.env` and fill secrets locally (do NOT commit `.env`).
#
# Backend (FastAPI) uses OpenRouter by default.
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
# Alternative: if your platform provides secrets via files (optional)
OPENROUTER_API_KEY_FILE=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MAX_TOKENS_SMALL=1024

# Optional: Gemini support (used in some scripts)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

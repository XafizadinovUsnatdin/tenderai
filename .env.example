# Copy to `.env` and fill secrets locally (do NOT commit `.env`).
#
# Backend (FastAPI) uses OpenRouter by default.
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
# Alternative: if your platform provides secrets via files (optional)
OPENROUTER_API_KEY_FILE=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MAX_TOKENS_SMALL=1024
# Optional: model for `/api/internet` OpenRouter fallback (defaults to OPENROUTER_MODEL)
OPENROUTER_INTERNET_MODEL=

# Prompt size controls (to avoid prompt token limit errors)
PROMPT_EVIDENCES_PER_SOURCE=10
PROMPT_MAX_TEXT_CHARS=1200

# Optional: Gemini (used by `/api/internet` after free web search, and as a Google Search grounding fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Grounding (Google Search) output limit
GEMINI_MAX_OUTPUT_TOKENS=1024

# Note:
# If you get `429 RESOURCE_EXHAUSTED` with `limit: 0`, it usually means your key/project
# has no quota provisioned for that model/tier. Check Gemini API quotas / billing,
# or try another model via `GEMINI_MODEL`.

# Free search:
# `POST /api/internet` uses a free DuckDuckGo-based search + extraction step (no API key).
# If Gemini/OpenRouter are unavailable, the endpoint returns this free result as-is (quality is lower than LLM grounding).

# Copy to `.env` and fill secrets locally (do NOT commit `.env`).

# Runtime
LLM_PROVIDER=openrouter
HOST=0.0.0.0
PORT=8000
APP_PORT=8000
WEB_CONCURRENCY=2
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MAX_TOKENS_SMALL=1024
OPENROUTER_INTERNET_MODEL=openai/gpt-4o-mini

# Prompt size / performance
PROMPT_EVIDENCES_PER_SOURCE=10
PROMPT_MAX_TEXT_CHARS=1200
XARID_CATEGORY_CACHE_TTL_SECONDS=1800
XARID_PAGE_CONCURRENCY=2
XARID_YEAR_CONCURRENCY=3

# Optional secrets via file mounts
OPENROUTER_API_KEY_FILE=

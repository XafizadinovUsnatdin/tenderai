# PostgreSQL database. Host port 55432 maps to container port 5432.
POSTGRES_DB=tenderai
POSTGRES_USER=tenderai
POSTGRES_PASSWORD=tenderai
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433

# Used when running collector directly on the host machine.
TENDER_ARCHIVE_DATABASE_URL=postgresql://tenderai:tenderai@127.0.0.1:55433/tenderai

# Collector behavior.
TENDER_ARCHIVE_SYNC_INTERVAL_SECONDS=300
TENDER_ARCHIVE_YEARS_BACK=5

# xarid.uzex.uz request tuning.
XARID_CATEGORY_CACHE_TTL_SECONDS=1800
XARID_PAGE_CONCURRENCY=2
XARID_YEAR_CONCURRENCY=3
XARID_REQUEST_TIMEOUT_SECONDS=60
XARID_REQUEST_RETRIES=3
XARID_REQUEST_RETRY_DELAY_SECONDS=2

# etender.uzex.uz request tuning.
ETENDER_REQUEST_TIMEOUT_SECONDS=60
ETENDER_REQUEST_RETRIES=3
ETENDER_REQUEST_RETRY_DELAY_SECONDS=2
